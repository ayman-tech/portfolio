---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { PROFILE } from '../data/portfolio';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import portrait from '../assets/profile.png';
import { getImage } from 'astro:assets';
const socialImage = await getImage({ src: portrait, width: 1200, format: 'jpeg' });
const title = `${PROFILE.name} — AI & ML Developer`;
const canonical = new URL('/', Astro.site);
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={`${PROFILE.tagline}. Explore Ayman Sayed’s projects, research, experience, and latest updates.`} />
    <meta name="color-scheme" content="dark light" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={PROFILE.tagline} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImage.src, Astro.site)} />
    <meta property="og:image:alt" content="Ayman Sayed" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script is:inline>
      try {
        const saved = localStorage.getItem('portfolio-theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch { /* Keep the default dark theme when storage is unavailable. */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" class="container"><slot /></main>
    <Footer />
  </body>
</html>
